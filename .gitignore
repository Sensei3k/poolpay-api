data.surreal/

# Tesseract OCR temp downloads
/private/tmp/receipt_engine/

# macOS filesystem noise
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.iml

# Rust coverage reports
tarpaulin-report.html
lcov.info

# Personal brain-sync state (not for sharing)
.brain-sync

